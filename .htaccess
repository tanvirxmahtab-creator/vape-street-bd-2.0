Options -Indexes
DirectoryIndex index.html index.php

# Custom error pages
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTP to HTTPS redirection
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Clean URLs (Allows Google to route /shop -> /shop.html, /about -> /about.html without 404)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# =====================================================================
# SECURITY HEADERS
# =====================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# =====================================================================
# CACHE STRATEGY — Prevents users from seeing stale/old versions
# =====================================================================
# RULE: HTML pages are NEVER cached. Every visit fetches fresh HTML.
#       CSS/JS/assets are cached long-term BUT with must-revalidate,
#       so bumping the ?v=YYYYMMDD query string in HTML forces browsers
#       to immediately download the new file on the next visit.
#
# HOW TO DEPLOY UPDATES:
#   1. Make your changes to CSS / JS files.
#   2. Find every <link> and <script> tag across all .html files.
#   3. Change the ?v= number to today's date, e.g. ?v=20261001
#   4. Upload updated files to Hostinger.
#   Result: All users instantly get the new version. Zero stale cache.
# =====================================================================

# Disable LiteSpeed full-page server-side caching for HTML & version.json
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

<IfModule mod_headers.c>
  # HTML and version.json — never cache, always revalidate
  <FilesMatch "\.(html|htm)$|^version\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, private, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-LiteSpeed-Cache-Control "no-cache, no-store, max-age=0"
    Header set X-LiteSpeed-Tag "no-cache"
    # Nuclear cache clear for all users: whenever version.json is fetched, wipe the browser's disk cache
    Header always set Clear-Site-Data "\"cache\"" env=MATCH_VERSION
  </FilesMatch>
  
  <FilesMatch "^version\.json$">
    SetEnv MATCH_VERSION 1
  </FilesMatch>

  # Static assets — cache 1 day (moderate cache, non-hashed)
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|ico|svg|mp4|webm|ogg|woff|woff2|ttf|eot|webmanifest)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable ETags for precise cache invalidation
FileETag MTime Size

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/json         "access plus 0 seconds"
  ExpiresDefault                         "access plus 1 day"
</IfModule>

# Enable gzip compression to reduce file sizes for faster loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json text/xml image/svg+xml
</IfModule>
